# Copy to .env and fill in. NEVER commit .env.
OPENAI_API_KEY=your-key-here

# Optional: any OpenAI-compatible provider.
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.0-flash
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1   OPENAI_API_KEY=ollama
# LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Retrieval: auto | on | off. "auto" uses embeddings only when the provider supports them,
# otherwise falls back to BM25 keyword search.
EMBEDDINGS=auto
EMBEDDING_MODEL=text-embedding-3-small
# Vector index: faiss (default; falls back to numpy if unavailable) | numpy
VECTOR_BACKEND=faiss

# Knowledge base folder. Defaults to knowledge_base/ (Markdown) if present, else knowledge_base_pdf/.
# KB_DIR=knowledge_base_pdf

# Force every agent to call its tool (recommended: models otherwise sometimes answer in plain text and the
# ticket is wrongly escalated). Use auto only if your provider rejects tool_choice=required.
TOOL_CHOICE=required

# Every answer must cite the passage it relies on with [1], [2]... A confident reply with no valid citation is escalated.
# REQUIRE_CITATIONS=true

# Optional Llama Guard safety screen on the customer's message (off when GUARD_MODEL is empty).
# Any OpenAI-compatible host works, e.g. Groq: GUARD_MODEL=meta-llama/llama-guard-4-12b
#   GUARD_BASE_URL=https://api.groq.com/openai/v1   Ollama: GUARD_MODEL=llama-guard3 GUARD_BASE_URL=http://localhost:11434/v1
# An unsafe verdict, or an unreachable guard, escalates the ticket to a human (fail closed).
# GUARD_MODEL=
# GUARD_BASE_URL=
# GUARD_API_KEY=
# GUARD_TIMEOUT=15

# Team orchestration: roundrobin (default) | selector
TEAM_MODE=roundrobin

# Guardrail tuning (defaults shown)
# MAX_COMPLAINT_CHARS=2000
# RATE_LIMIT_PER_MIN=10
# CONFIDENCE_THRESHOLD=0.6
# KB_MIN_SCORE=0.08

# Password-reset emails. EMAIL_BACKEND: smtp (used automatically when SMTP_HOST is set) | outbox (saves the email to
# data/outbox/ instead of sending it: for demos and local development only) | off
# APP_BASE_URL=https://support.example.com   # the public address of this app; used to build the reset link
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASSWORD=secret
# SMTP_FROM=NovaCart Support <no-reply@yourdomain.com>
# SMTP_STARTTLS=true
# RESET_TOKEN_MINUTES=30
# RESET_REQUESTS_PER_HOUR=3

# Accounts and sessions (defaults shown)
# DB_PATH=data/support.db   # SQLite: accounts, tickets, audit trail
# CACHE_DIR=.cache          # FAISS index (the embedding store)
# SESSION_TIMEOUT_MIN=30
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15

# Inbound email: customer emails become tickets and run through the same four agents.
# MAIL_BACKEND: imap (used automatically when IMAP_HOST is set) | folder (reads .eml files from data/inbox/, for demos) | off
# Gmail/Outlook need an app password. Replies go out through the SMTP_* settings above.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=support@yourdomain.com
# IMAP_PASSWORD=app-password
# IMAP_FOLDER=INBOX
# MAIL_POLL_SECONDS=60      # how often the mailbox is checked
# MAIL_AUTO=true            # the web app checks the mailbox by itself in the background; false = only the button / python inbox.py
# MAIL_MAX_PER_POLL=10
# MAIL_TRIAGE=true          # one LLM call per email: only support requests enter the agents; the rest get a polite auto-reply (no ticket)

# Voice and photo input (web form and email attachments). Voice -> speech-to-text, photos -> a vision model; both become text
# before the four agents run. They default to your main OPENAI_API_KEY / LLM_BASE_URL / LLM_MODEL.
# Groq example: STT_MODEL=whisper-large-v3 (STT_BASE_URL=https://api.groq.com/openai/v1) and a vision model such as VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# MEDIA_INPUT=true
# STT_MODEL=whisper-1
# VISION_MODEL=gpt-4o-mini
# MAX_AUDIO_MB=10
# MAX_IMAGE_MB=5
# MAX_IMAGES=3

# Telegram complaints (python telegram_bot.py): free, no public URL needed (the bot polls Telegram). Customers send text, voice notes or photos.
# In Telegram open @BotFather, send /newbot, follow the prompts, and paste the token it gives you.
# TELEGRAM_BOT_TOKEN=123456789:AAH...

# Fast model (DeepSeek by default): email/chat triage, the query-analysis agent and the two tool-calling agents (knowledge, log) use it;
# the ResolutionAgent, which writes the customer's reply, keeps the main model above. Leave the key empty to use the main model for everything.
# Note: complaint text is sent to this provider as well.
# DEEPSEEK_API_KEY=sk-...
# FAST_MODEL=deepseek-chat
# FAST_BASE_URL=https://api.deepseek.com
# MAX_PARALLEL=3            # tickets handled at the same time by the mailbox poller and the Telegram bot

# Voice complaints over LiveKit Cloud (python voice_agent.py dev). From cloud.livekit.io -> your project -> Settings -> API keys.
# Speech-to-text, the conversation model and text-to-speech run on LiveKit Inference, billed to your LiveKit plan (no other keys).
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=API...
# LIVEKIT_API_SECRET=...
# VOICE_AGENT_NAME=novacart-support
# VOICE_STT=assemblyai/universal-3-6-pro
# GROQ_API_KEY=gsk_...       # when set, the voice conversation model runs on Groq (VOICE_GROQ_MODEL), otherwise on LiveKit Inference (VOICE_LLM)
# VOICE_GROQ_MODEL=openai/gpt-oss-120b   # must be a model your Groq key can use: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# VOICE_LLM=google/gemma-4-31b-it
# VOICE_TTS=fishaudio/s2.1-pro
# VOICE_STT_LANGUAGE=multi  # multi (default) detects the caller's language; set en, hi, ta, ... to fix it, which is more reliable on short audio.
# With GROQ_API_KEY set, speech-to-text also runs on Groq: uploaded voice files and Telegram voice notes (STT_MODEL, default whisper-large-v3-turbo)
# and the live voice agent (VOICE_GROQ_STT). Set STT_MODEL / STT_BASE_URL / STT_API_KEY explicitly to use another provider.
# VOICE_GROQ_STT=whisper-large-v3-turbo
